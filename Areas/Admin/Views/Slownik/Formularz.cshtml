@model SlownikFormularz
@{
    var nowa = Model.Id is null;
    var pozycja = ViewData["NazwaPozycji"] as string;
    var tytul = nowa ? $"Nowa pozycja: {pozycja}" : $"Edycja: {Model.Nazwa}";
    ViewData["Title"] = ViewData.ModelState.IsValid ? tytul : $"Błąd w formularzu – {tytul}";
}

<h1>@tytul</h1>
<partial name="_PodsumowanieBledow" />

<form method="post" novalidate class="formularz-admina">
    <pole for="Nazwa" />
    <pole for="Opis" typ="textarea" />
    @if (ViewData["MaIkone"] is true)
    {
        <pole for="Ikona" wskazowka="Nazwa ikony wyświetlanej obok tekstu, np. elevator. Ikona nigdy nie zastępuje nazwy." />
    }
    <div class="przyciski-formularza">
        <button type="submit" class="btn btn-primary">@(nowa ? "Dodaj" : "Zapisz zmiany")</button>
        <a asp-action="Index">Anuluj i wróć do listy</a>
    </div>
</form>
