@model List<WpisAudytuWidok>
@{
    ViewData["Title"] = "Rejestr zmian";
}

<h1>Rejestr zmian</h1>
<p>Ostatnie @Model.Count zmian danych: kto, kiedy, co i jak zmienił. Najnowsze na górze.</p>

@if (Model.Count == 0)
{
    <p>Rejestr jest pusty.</p>
}
else
{
    <div class="tabela-przewijana" tabindex="0" role="region" aria-label="Rejestr zmian — tabela">
        <table class="table tabela-admina">
            <caption>Rejestr zmian danych przewodnika</caption>
            <thead>
                <tr>
                    <th scope="col">Data</th>
                    <th scope="col">Użytkownik</th>
                    <th scope="col">Operacja</th>
                    <th scope="col">Rekord</th>
                    <th scope="col">Przed zmianą</th>
                    <th scope="col">Po zmianie</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var w in Model)
                {
                    <tr>
                        <td>@w.Data.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td>@w.Uzytkownik</td>
                        <td>@(w.Operacja switch { "INSERT" => "dodanie", "UPDATE" => "zmiana", "DELETE" => "usunięcie", _ => w.Operacja })</td>
                        <th scope="row">@w.Encja @w.Klucz</th>
                        <td><code class="json">@w.Stare</code></td>
                        <td><code class="json">@w.Nowe</code></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
