@model IReadOnlyList<UwagaWalidatora>
@{
    ViewData["Title"] = "Walidacja grafu";
    var bledy = Model.Where(u => u.Poziom == PoziomUwagi.Blad).ToList();
    var ostrzezenia = Model.Where(u => u.Poziom == PoziomUwagi.Ostrzezenie).ToList();
    var podsumowanie = Model.Count == 0
        ? "Walidacja zakończona. Graf nie ma uwag."
        : $"Walidacja zakończona. Znaleziono problemów: {Model.Count}. Błędy krytyczne: {bledy.Count}. Ostrzeżenia: {ostrzezenia.Count}.";
}

<h1>Walidacja grafu</h1>
<p>Sprawdzenie danych nawigacji przed wdrożeniem. Błędy krytyczne sprawiają, że przewodnik poprowadzi źle albo wcale;
   ostrzeżenia wymagają decyzji redaktora.</p>

@* Wynik walidacji: po załadowaniu trafia na niego fokus (site.js), więc czytnik czyta go raz — bez aria-live. *@
<p class="komunikat @(bledy.Count > 0 ? "komunikat--blad" : "komunikat--sukces")" tabindex="-1" data-fokus-po-zaladowaniu>
    <strong>@podsumowanie</strong>
</p>

@if (bledy.Count > 0)
{
    <h2 id="bledy-krytyczne">Błędy krytyczne (@bledy.Count)</h2>
    <partial name="_TabelaUwag" model="@(("Błędy krytyczne", bledy))" />
}

@if (ostrzezenia.Count > 0)
{
    <h2 id="ostrzezenia">Ostrzeżenia (@ostrzezenia.Count)</h2>
    <partial name="_TabelaUwag" model="@(("Ostrzeżenia", ostrzezenia))" />
}
