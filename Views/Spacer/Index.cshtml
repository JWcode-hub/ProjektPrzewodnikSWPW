@model BudynkiViewModel
@{
    ViewData["Title"] = "Spacer po budynkach";
}

<h1>Spacer po budynkach</h1>
<p>Wybierz budynek, od którego chcesz zacząć. W każdym miejscu poznasz jego opis i wybierzesz kierunek:
   prosto, w lewo, w prawo albo do tyłu.</p>

@if (Model.Budynki.Count == 0)
{
    <p>Nie ma jeszcze żadnego budynku do zwiedzania.</p>
}
else
{
    <h2>Budynki Uczelni</h2>
    <ul>
        @foreach (var budynek in Model.Budynki)
        {
            <li>
                <a asp-action="Budynek" asp-route-kodBudynku="@budynek.Kod">@budynek.Nazwa</a>
                @if (budynek.Adres is not null)
                {
                    <br />@budynek.Adres
                }
            </li>
        }
    </ul>
}
