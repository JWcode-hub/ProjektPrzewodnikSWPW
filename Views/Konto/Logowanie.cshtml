@model LogowanieViewModel
@{
    ViewData["Title"] = ViewData.ModelState.IsValid ? "Logowanie" : "Błąd logowania – Logowanie";
}

<h1>Logowanie do panelu administratora</h1>
<p>Panel służy pracownikom Uczelni do zarządzania danymi przewodnika. Zwiedzanie budynków i wyszukiwanie sal nie wymaga logowania.</p>

<partial name="_PodsumowanieBledow" />

<form method="post" asp-action="Logowanie" novalidate class="formularz-admina">
    <input type="hidden" asp-for="ReturnUrl" />
    <pole for="Email" typ="email" autocomplete="username" />
    <pole for="Haslo" typ="password" autocomplete="current-password" />
    <button type="submit" class="btn btn-primary">Zaloguj się</button>
</form>
