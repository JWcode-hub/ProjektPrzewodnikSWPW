@model UstawieniaViewModel
@{
    var komunikat = ViewData["Komunikat"] as string;
    var saBledy = !ViewData.ModelState.IsValid;

    // Tytuł mówi o wyniku zapisu także bez JavaScriptu — czytnik ekranu odczytuje go po przeładowaniu.
    ViewData["Title"] = saBledy ? "Błąd w formularzu – Ustawienia dostępności"
        : komunikat is not null ? "Zapisano – Ustawienia dostępności"
        : "Ustawienia dostępności";

    string? Blad(string pole) =>
        ViewData.ModelState.TryGetValue(pole, out var stan) && stan.Errors.Count > 0
            ? stan.Errors[0].ErrorMessage
            : null;

    // Fokus po błędzie: pierwsze błędne pole (autofocus działa bez JavaScriptu). W grupie opcji — jej pierwsza opcja.
    var autofocusUzyty = false;
    string? Autofocus(string pole, bool pierwszaOpcja = true)
    {
        if (autofocusUzyty || !pierwszaOpcja || Blad(pole) is null) { return null; }
        autofocusUzyty = true;
        return "autofocus";
    }
}

<h1 id="naglowek-strony" tabindex="-1">Ustawienia dostępności</h1>

@if (komunikat is not null)
{
    <p class="komunikat komunikat--sukces" tabindex="-1" data-fokus-po-zaladowaniu>@komunikat</p>
}

@if (saBledy)
{
    <div class="komunikat komunikat--blad" tabindex="-1" data-fokus-po-zaladowaniu>
        <h2 class="h5">Popraw zaznaczone pola</h2>
        <ul>
            @foreach (var (pole, stan) in ViewData.ModelState)
            {
                foreach (var blad in stan.Errors)
                {
                    <li><a href="#pole-@pole">@blad.ErrorMessage</a></li>
                }
            }
        </ul>
    </div>
}

<p>Ustawienia zapamiętujemy w tej przeglądarce. Nie musisz się logować.</p>
<p id="podglad-info" hidden>Zmiany widać od razu. Aby je zachować, wybierz przycisk „Zapisz ustawienia” na dole formularza.</p>

<form method="post" asp-action="Index" id="formularz-ustawien" novalidate>
    <fieldset class="mb-4" id="pole-Motyw" aria-describedby="@(Blad("Motyw") is null ? null : "blad-Motyw")">
        <legend class="h4">Motyw kolorystyczny</legend>
        @if (Blad("Motyw") is { } bladMotywu)
        {
            <p id="blad-Motyw" class="komunikat-bledu">Błąd: @bladMotywu</p>
        }
        @foreach (var (wartosc, nazwa, opis) in UstawieniaViewModel.Motywy)
        {
            <div class="form-check">
                <input class="form-check-input" type="radio" asp-for="Motyw" value="@wartosc" id="motyw-@wartosc"
                       autofocus="@Autofocus("Motyw", wartosc == UstawieniaViewModel.Motywy[0].Wartosc)" />
                <label class="form-check-label" for="motyw-@wartosc">@nazwa — @opis</label>
            </div>
        }
    </fieldset>

    <fieldset class="mb-4" id="pole-RozmiarTekstu" aria-describedby="@(Blad("RozmiarTekstu") is null ? null : "blad-RozmiarTekstu")">
        <legend class="h4">Rozmiar tekstu</legend>
        @if (Blad("RozmiarTekstu") is { } bladRozmiaru)
        {
            <p id="blad-RozmiarTekstu" class="komunikat-bledu">Błąd: @bladRozmiaru</p>
        }
        @foreach (var rozmiar in PrzewodnikSWPW.Web.Services.UstawieniaDostepnosci.DozwoloneRozmiaryTekstu)
        {
            <div class="form-check">
                <input class="form-check-input" type="radio" asp-for="RozmiarTekstu" value="@rozmiar" id="rozmiar-@rozmiar"
                       autofocus="@Autofocus("RozmiarTekstu", rozmiar == PrzewodnikSWPW.Web.Services.UstawieniaDostepnosci.DozwoloneRozmiaryTekstu[0])" />
                <label class="form-check-label" for="rozmiar-@rozmiar">@rozmiar% @(rozmiar == 100 ? "(domyślny)" : "")</label>
            </div>
        }
    </fieldset>

    <fieldset class="mb-4">
        <legend class="h4">Mowa syntetyczna</legend>
        <div class="form-check mb-2">
            <input class="form-check-input" type="checkbox" asp-for="MowaWlaczona" id="pole-MowaWlaczona" aria-describedby="mowa-opis" />
            <label class="form-check-label" asp-for="MowaWlaczona" for="pole-MowaWlaczona"></label>
        </div>
        <p id="mowa-opis">
            Ta opcja czyta opis miejsca głosem przeglądarki. Jeśli korzystasz z czytnika ekranu
            (NVDA, JAWS, VoiceOver), zostaw ją wyłączoną — Twój czytnik już czyta całą stronę,
            a dwa głosy naraz nakładają się na siebie.
            Po włączeniu przy opisie miejsca pojawią się przyciski „Przeczytaj opis” i „Zatrzymaj czytanie”.
        </p>

        <label class="form-label" asp-for="TempoMowy" for="pole-TempoMowy"></label>
        @if (Blad("TempoMowy") is { } bladTempa)
        {
            <p id="blad-TempoMowy" class="komunikat-bledu">Błąd: @bladTempa</p>
        }
        <select class="form-select" asp-for="TempoMowy" id="pole-TempoMowy"
                aria-describedby="@(Blad("TempoMowy") is null ? null : "blad-TempoMowy")"
                aria-invalid="@(Blad("TempoMowy") is null ? null : "true")"
                autofocus="@Autofocus("TempoMowy")">
            @foreach (var tempo in PrzewodnikSWPW.Web.Services.UstawieniaDostepnosci.DozwoloneTempaMowy)
            {
                <option value="@tempo">@UstawieniaViewModel.OpisTempa(tempo)</option>
            }
        </select>
    </fieldset>

    <fieldset class="mb-4">
        <legend class="h4">Klawiatura i ruch</legend>
        <div class="form-check mb-2">
            <input class="form-check-input" type="checkbox" asp-for="SkrotyWlaczone" id="pole-SkrotyWlaczone" aria-describedby="skroty-opis" />
            <label class="form-check-label" asp-for="SkrotyWlaczone" for="pole-SkrotyWlaczone"></label>
        </div>
        <p id="skroty-opis">
            Wyłącz skróty, jeśli przeszkadzają ci w pracy z czytnikiem ekranu.
            Wykaz skrótów znajdziesz na stronie <a href="/skroty-klawiszowe">Skróty klawiszowe</a>.
        </p>

        <div class="form-check">
            <input class="form-check-input" type="checkbox" asp-for="OgraniczAnimacje" id="pole-OgraniczAnimacje" />
            <label class="form-check-label" asp-for="OgraniczAnimacje" for="pole-OgraniczAnimacje"></label>
        </div>
    </fieldset>

    <button type="submit" class="btn btn-primary">Zapisz ustawienia</button>
</form>
