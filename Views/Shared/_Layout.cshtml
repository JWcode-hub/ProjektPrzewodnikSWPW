@inject UstawieniaDostepnosciService UstawieniaDostepnosci
@{
    var u = UstawieniaDostepnosci.Pobierz();
    var motyw = u.Motyw switch
    {
        Motyw.Podstawowy => "podstawowy",
        Motyw.WysokiKontrast => "wysoki-kontrast",
        Motyw.Ciemny => "ciemny",
        _ => "systemowy",
    };
    var powrot = Context.Request.Path + Context.Request.QueryString;
}
<!DOCTYPE html>
<html lang="pl"
      data-motyw="@motyw"
      data-rozmiar="@u.RozmiarTekstu"
      data-animacje="@(u.OgraniczAnimacje ? "ograniczone" : "pelne")"
      data-mowa="@(u.MowaWlaczona ? "wlaczona" : "wylaczona")"
      data-tempo-mowy="@u.TempoMowy"
      data-skroty="@(u.SkrotyWlaczone ? "wlaczone" : "wylaczone")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @* Unikalny tytuł każdej strony: nazwa strony – nazwa serwisu. *@
    <title>@ViewData["Title"] – Multimedialny przewodnik po Uczelni – SWPW</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @* Pierwszy element strony: pozwala ominąć nawigację klawiaturą (WCAG 2.4.1). *@
    <a href="#tresc" class="link-pomin">Przejdź do treści głównej</a>

    <header class="naglowek-serwisu">
        <div class="container">
            <nav aria-label="Nawigacja główna">
                <ul class="lista-nawigacji">
                    <li><a class="nazwa-serwisu" asp-controller="Home" asp-action="Index">Multimedialny przewodnik po Uczelni</a></li>
                    <li><a asp-controller="Spacer" asp-action="Index">Spacer po budynkach</a></li>
                    <li><a asp-controller="Szukaj" asp-action="Index">Szukaj sali</a></li>
                    <li><a asp-controller="Trasa" asp-action="Index">Wyznacz trasę</a></li>
                </ul>
            </nav>
        </div>
    </header>

    @* Miejsce na dodatkową nawigację (np. menu panelu) — przed <main>, żeby link pominięcia ją omijał. *@
    @await RenderSectionAsync("PrzedTrescia", required: false)

    <main id="tresc" tabindex="-1" class="container py-3">
        @RenderBody()

        @* Jedyny obszar ogłoszeń na stronie. Jest w kodzie od załadowania i jest PUSTY:
           po pełnym przeładowaniu nic do niego nie wpisujemy (zasada ogłaszania w site.js). *@
        <div id="komunikaty" role="status" aria-live="polite" aria-atomic="true"></div>
    </main>

    <footer class="stopka-serwisu">
        <div class="container">
            <nav aria-label="Informacje prawne">
                <ul class="lista-stopki">
                    <li><a href="/deklaracja-dostepnosci">Deklaracja Dostępności</a></li>
                    <li><a href="/skroty-klawiszowe">Skróty klawiszowe</a></li>
                    <li><a href="/zglos-problem">Zgłoś brak dostępności</a></li>
                    <li><a href="/polityka-prywatnosci">Polityka prywatności</a></li>
                    <li><a href="/ustawienia">Ustawienia dostępności</a></li>
                </ul>
            </nav>

            @* Przełącznik motywu na każdej stronie. Bez automatycznego wysyłania po zmianie (WCAG 3.2.2). *@
            <form method="post" asp-controller="Ustawienia" asp-action="Motyw" class="przelacznik-motywu">
                <input type="hidden" name="powrot" value="@powrot" />
                <label for="stopka-motyw">Motyw kolorystyczny</label>
                <select id="stopka-motyw" name="motyw" class="form-select">
                    @foreach (var (wartosc, nazwa, _) in UstawieniaViewModel.Motywy)
                    {
                        <option value="@wartosc" selected="@(wartosc == u.Motyw)">@nazwa</option>
                    }
                </select>
                <button type="submit" class="btn btn-secondary">Zmień motyw</button>
            </form>

            <p class="mb-0">Szkoła Wyższa im. Pawła Włodkowica w Płocku</p>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
