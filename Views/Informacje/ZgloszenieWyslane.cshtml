@model DeklaracjaDostepnosciOptions
@{
    ViewData["Title"] = "Zgłoszenie przyjęte";
}

<h1 tabindex="-1" data-fokus-po-zaladowaniu>Zgłoszenie przyjęte</h1>

<p class="komunikat komunikat--sukces">Dziękujemy za zgłoszenie braku dostępności.</p>

<p>Zgłoszenie zostało zapisane. Jeśli podałeś adres e-mail, odpowiedź przyjdzie na ten adres — nie później niż
    w ciągu 7 dni.</p>

@if (Model.Email is not null)
{
    <p>Jeśli sprawa jest pilna, napisz na adres <a href="mailto:@Model.Email">@Model.Email</a>.</p>
}

<ul>
    <li><a href="/deklaracja-dostepnosci">Przeczytaj procedurę rozpatrywania zgłoszeń w Deklaracji Dostępności</a></li>
    <li><a href="/">Wróć na stronę główną przewodnika</a></li>
</ul>
